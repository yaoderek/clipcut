 "captions": [
  {
   "start": 0.39,
   "end": 5.47,
   "text": "My mother works at NIOSH and has been there since I was a young child."
  },
  {
   "start": 5.71,
   "end": 8.85,
   "text": "My mom brought me in for mother, daughter, day, probably in my mid teens."
  },
  {
   "start": 8.93,
   "end": 16.58,
   "text": "And I got to see what epidemiologists do and I got to hang out with industrial hygienists and other researchers and kind of see what they"
  },
  {
   "start": 16.79,
   "end": 18.17,
   "text": "And that was sort of my first introduction."
  },
  {
   "start": 18.38,
   "end": 20.6,
   "text": "I never expected to be an epidemiology."
  },
  {
   "start": 20.68,
   "end": 23.66,
   "text": "I started out wanting to be a teacher and then I couldn't afford to go to school."
  },
  {
   "start": 23.66,
   "end": 27.66,
   "text": "And then when I could afford to go to school, I thought, I'm going to be a clinical psychologist."
  }
 ],
