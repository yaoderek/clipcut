 "captions": [
  {
   "start": 0.0,
   "end": 2.19,
   "text": "There's just no price you can put on that."
  },
  {
   "start": 2.48,
   "end": 7.6,
   "text": "My mother works at NIOSH and has been there since I was a young child."
  },
  {
   "start": 8.04,
   "end": 16.13,
   "text": "My mom brought me in for mother-daughter day probably in my mid-teens, and I got to see what epidemiologists do and I got to hang out"
  },
  {
   "start": 16.13,
   "end": 20.35,
   "text": "with industrial hygienists and other researchers and kind of see what they do."
  },
  {
   "start": 20.91,
   "end": 22.41,
   "text": "That was sort of my first introduction."
  },
  {
   "start": 22.54,
   "end": 23.73,
   "text": "I never expected to be in epidemiology."
  },
  {
   "start": 23.73,
   "end": 30.48,
   "text": "I started out wanting to be a teacher, and then I couldn't afford to go to school, and then when I could afford to go to"
  },
  {
   "start": 30.48,
   "end": 32.35,
   "text": "school, I thought, I'm going to be a clinical psychologist."
  },
  {
   "start": 32.47,
   "end": 33.68,
   "text": "So I went into psychology."
  },
  {
   "start": 33.68,
   "end": 40.41,
   "text": "One of the reasons I went into psychology was there was no math or science, or so I thought."
  }
 ],
