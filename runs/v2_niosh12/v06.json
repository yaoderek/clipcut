 "captions": [
  {
   "start": 0.0,
   "end": 5.09,
   "text": "One of my favorite things about being an epidemiologist is just the variety to the job."
  },
  {
   "start": 5.09,
   "end": 12.03,
   "text": "There's never a boring day, and really being able to go after those answers to research questions."
  },
  {
   "start": 12.03,
   "end": 15.77,
   "text": "That I myself can go out and try to find the answers."
  },
  {
   "start": 15.77,
   "end": 17.95,
   "text": "And I absolutely love my job."
  },
  {
   "start": 17.95,
   "end": 21.1,
   "text": "I feel like I'm doing a good thing."
  },
  {
   "start": 21.1,
   "end": 23.4,
   "text": "I'm impacting, potentially, workers' lives."
  },
  {
   "start": 23.4,
   "end": 25.67,
   "text": "There's just no price you can put on that."
  },
  {
   "start": 25.95,
   "end": 31.08,
   "text": "My mother works at NIOSH and has been there since I was a young child."
  }
 ],
